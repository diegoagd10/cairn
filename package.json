{
  "name": "@diegoagd10/cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Personal specs and tickets for every repository",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "bin": {
    "cairn": "dist/cli.js"
  },
  "scripts": {
