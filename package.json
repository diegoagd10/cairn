    "prepare": "npm run build"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^7.0.2"
  }
